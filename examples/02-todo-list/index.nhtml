<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHTML v0.4.0 | Todo List</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/examples/assets/premium.css">
    <style>
        .todo-input-group {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .todo-input-group input {
            flex: 1;
        }
        .todo-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .todo-item {
            background: rgba(255, 255, 255, 0.05);
            padding: 1rem 1.5rem;
            border-radius: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid var(--border);
            animation: slideIn 0.3s ease-out;
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-10px); }
            to { opacity: 1; transform: translateX(0); }
        }
        .todo-item .text {
            font-size: 1.1rem;
        }
        .todo-item .btn-delete {
            background: rgba(255, 50, 50, 0.2);
            color: #ff5555;
            padding: 0.5rem;
            border-radius: 8px;
            font-size: 0.8rem;
        }
        .todo-item .btn-delete:hover {
            background: #ff3333;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="premium-container">
        <a href="/examples/index.nhtml" class="nav-back">← Retour au Hub</a>
        
        <div class="example-wrapper">
            <h3>Liste de Tâches</h3>
            <p class="subtitle">Ajoutez des éléments dynamiquement via le protocole binaire.</p>
            
            <div class="todo-input-group">
                <input n-id="todo_input" type="text" placeholder="Qu'y a-t-il à faire ?">
                <button n-id="btn_add_todo" n-click="add_todo">AJOUTER</button>
            </div>

            <div n-id="todo_list" class="todo-list">
                <!-- Les tâches seront injectées ici -->
            </div>
        </div>
    </div>
</body>
</html>
