<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHTML | 04 — Style Lab</title>
    <link rel="stylesheet" href="../assets/css/modern.css">
    <style>
        body { align-items: center; gap: 32px; flex-direction: row; flex-wrap: wrap; }
        #preview_box {
            width: 240px; height: 240px; background: #38bdf8; border-radius: 12px;
            box-shadow: 0 20px 60px rgba(56,189,248,0.4);
            transition: border-radius 0.1s, background 0.15s, box-shadow 0.15s, transform 0.15s;
            display: flex; align-items: center; justify-content: center; font-size: 2.5rem;
        }
        .glass-card { width: 360px; }
        .control-group { margin-bottom: 1.5rem; }
        .control-label { display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; }
        .control-label span { color: var(--accent); font-weight: 700; font-size: 0.85rem; }
        input[type=range] { width: 100%; -webkit-appearance: none; height: 6px; border-radius: 99px; background: rgba(255,255,255,0.1); outline: none; cursor: pointer; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 20px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px rgba(56,189,248,0.5); cursor: pointer; transition: transform 0.2s; }
        input[type=range]::-webkit-slider-thumb:hover { transform: scale(1.3); }
        .color-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
        .color-swatch { width: 36px; height: 36px; border-radius: 8px; cursor: pointer; border: 2px solid transparent; transition: transform 0.2s, border-color 0.2s; }
        .color-swatch:hover { transform: scale(1.15); }
        .color-swatch.active { border-color: white; transform: scale(1.15); }
        .divider { border: none; border-top: 1px solid rgba(255,255,255,0.07); margin: 1.2rem 0; }
        .stat-row { display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--text-dim); font-family: monospace; }
        .stat-row strong { color: var(--text); }
    </style>
</head>
<body>
    <div n-id="preview_box" id="preview_box">✦</div>

    <div class="glass-card">
        <h1>🎨 Style Lab — Niveau 4</h1>
        <p style="font-size:0.78rem;color:var(--text-dim);margin-bottom:1.5rem;">
            Manipulation CSS en temps réel via PHP. Zéro JS applicatif.
        </p>

        <div class="control-group">
            <div class="control-label">Border Radius <span n-id="lbl_radius">12px</span></div>
            <input type="range" n-id="slider_radius" n-input="slider_radius" min="0" max="120" value="12">
        </div>

        <div class="control-group">
            <div class="control-label">Scale <span n-id="lbl_scale">1.0×</span></div>
            <input type="range" n-id="slider_scale" n-input="slider_scale" min="50" max="150" value="100">
        </div>

        <div class="control-group">
            <div class="control-label">Glow Intensity <span n-id="lbl_shadow">40%</span></div>
            <input type="range" n-id="slider_shadow" n-input="slider_shadow" min="0" max="100" value="40">
        </div>

        <hr class="divider">

        <div class="control-group">
            <div class="control-label">Couleur</div>
            <div class="color-grid">
                <div class="color-swatch active" n-id="color_0" n-click="select" style="background:#38bdf8;"></div>
                <div class="color-swatch" n-id="color_1" n-click="select" style="background:#a78bfa;"></div>
                <div class="color-swatch" n-id="color_2" n-click="select" style="background:#34d399;"></div>
                <div class="color-swatch" n-id="color_3" n-click="select" style="background:#f472b6;"></div>
                <div class="color-swatch" n-id="color_4" n-click="select" style="background:#fb923c;"></div>
                <div class="color-swatch" n-id="color_5" n-click="select" style="background:#facc15;"></div>
            </div>
        </div>

        <hr class="divider">

        <div class="stat-row">
            <span>Dernier patch</span>
            <strong n-id="stat_last">—</strong>
        </div>
    </div>
</body>
</html>
