<!nhtml 1.0>

<head>
    <title>Nhtml — Test v0.1</title>
</head>

<!-- Variables globales réactives -->
<var compteur=0>
<var nom="Alice">
<var estConnecte=false>
<var produits=[{"nom":"Chaise","prix":49,"stock":true},{"nom":"Table","prix":120,"stock":false},{"nom":"Lampe","prix":35,"stock":true}]>

<body>

    <h1>Test Nhtml Parser</h1>

    <!-- ── TEST 1 : Variables et liaison {} ── -->
    <h2>1. Variables réactives</h2>
    <p text="Bonjour {nom}, compteur = {compteur}"/>
    <button on:click="compteur++" label="+1"/>
    <button on:click="compteur=0" label="Reset"/>

    <!-- ── TEST 2 : Conditions attribut if ── -->
    <h2>2. Conditions simples</h2>
    <p if="{estConnecte}" text="Vous êtes connecté"/>
    <p if="!estConnecte" text="Vous n'êtes pas connecté"/>
    <button on:click="estConnecte=!estConnecte" label="Basculer connexion"/>

    <!-- ── TEST 3 : Blocs if/elseif/else ── -->
    <h2>3. Blocs conditionnels</h2>
    <if condition="{compteur == 0}">
        <p>Compteur à zéro</p>
    </if>
    <elseif condition="{compteur < 5}">
        <p>Compteur petit</p>
    </elseif>
    <else>
        <p>Compteur grand</p>
    </else>

    <!-- ── TEST 4 : Listes <each> ── -->
    <h2>4. Listes</h2>
    <each in="{produits}" as="produit" index="i">
        <div style="border:1px solid #ccc; padding:8px; margin:4px">
            <strong>{i}. {produit.nom}</strong> — {produit.prix} €
        </div>
    </each>
    <empty for="#produits">
        <p>Aucun produit.</p>
    </empty>

    <!-- ── TEST 5 : Formulaire ── -->
    <h2>5. Formulaire</h2>
    <var email="">
    <form on:submit="alert('Soumis : ' + email)">
        <input type="text"
               bind:value="{email}"
               validate:required
               validate:format="email"
               validate:message="Email invalide"
               validate:when="blur"
               placeholder="Votre email"/>
        <button type="submit" label="Envoyer"/>
    </form>

</body>

<style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #1A1A2E; }
    h2 { color: #0F3460; border-bottom: 1px solid #eee; padding-bottom: 8px; }
    button { margin: 4px; padding: 8px 16px; background: #1A1A2E; color: white; border: none; border-radius: 4px; cursor: pointer; }
    input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 300px; }
</style>
