<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHTML | 02 — Todo List</title>
    <link rel="stylesheet" href="../assets/css/modern.css">
    <style>
        .todo-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.04);
            margin-bottom: 10px;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.06);
            animation: slideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            font-size: 0.95rem;
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-10px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        .del-btn {
            background: rgba(239,68,68,0.15);
            color: #ef4444;
            border: 1px solid rgba(239,68,68,0.3);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 700;
            cursor: pointer;
        }
        .del-btn:hover { background: rgba(239,68,68,0.3); transform: scale(1.05); }
        .todo-list { max-height: 320px; overflow-y: auto; padding-right: 4px; }
        .footer { margin-top: 1.2rem; font-size: 0.72rem; color: rgba(255,255,255,0.25); display: flex; justify-content: space-between; }
        .badge { background: var(--accent); color: #000; border-radius: 99px; padding: 1px 10px; font-weight: 700; }
    </style>
</head>
<body>
    <div class="glass-card" style="width: 440px;">
        <h1>✅ Tasks — Niveau 2</h1>

        <div class="input-group">
            <input type="text" id="task_input" placeholder="Prochaine étape…">
            <button id="btn_add">AJOUTER</button>
        </div>

        <ul class="todo-list" id="list_container"></ul>

        <div class="footer">
            <span>NHTML Binary Flow — APPEND_HTML / REMOVE_NODE</span>
            <span class="badge" id="task_count">0</span>
        </div>
    </div>
    <!-- bridge.js + fzstd injectés automatiquement par le Gateway -->
</body>
</html>
