<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NHTML DevTools Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #050505;
            --surface: rgba(255, 255, 255, 0.05);
            --accent: #ff007f;
            --text: #ffffff;
            --text-dim: rgba(255, 255, 255, 0.5);
            --green: #0f0;
        }
        body {
            margin: 0; background: var(--bg); color: var(--text);
            font-family: 'Outfit', sans-serif;
            height: 100vh; display: flex; flex-direction: column; overflow: hidden;
        }
        header {
            padding: 15px 25px; background: var(--surface); border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex; justify-content: space-between; align-items: center;
        }
        .title { font-weight: 700; color: var(--accent); letter-spacing: 2px; font-size: 0.9rem; }
        
        .tabs { display: flex; gap: 20px; }
        .tab { 
            cursor: pointer; padding-bottom: 5px; border-bottom: 2px solid transparent; 
            color: var(--text-dim); transition: 0.3s; font-size: 0.8rem; font-weight: bold;
        }
        .tab.active { color: var(--accent); border-bottom-color: var(--accent); }

        main { flex: 1; display: flex; overflow: hidden; position: relative; }
        
        /* Dashboard / Sessions */
        .pane { flex: 1; display: none; height: 100%; overflow: hidden; }
        .pane.active { display: flex; flex-direction: column; }

        #pane-sessions { padding: 40px; max-width: 900px; margin: 0 auto; width: 100%; }
        .session-btn { 
            background: var(--surface); border: 1px solid rgba(255,255,255,0.1); 
            width: 100%; text-align: left; padding: 15px 25px; border-radius: 12px;
            color: var(--text); font-family: 'JetBrains Mono', monospace; cursor: pointer;
            margin-bottom: 10px; transition: 0.2s;
        }
        .session-btn:hover { background: rgba(255,0,127,0.15); border-color: var(--accent); transform: translateX(5px); }

        /* Network Monitor */
        .net-header { 
            display: grid; grid-template-columns: 80px 100px 100px 1fr; gap: 10px; 
            padding: 10px 20px; background: rgba(255,255,255,0.02); 
            font-size: 0.7rem; font-weight: bold; color: var(--text-dim); text-transform: uppercase;
        }
        #net-table { flex: 1; overflow-y: auto; padding: 0 10px; display: flex; flex-direction: column-reverse; }

        /* Generic Controls */
        button.action {
            background: var(--accent); color: #fff; border: none; padding: 8px 16px;
            border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-weight: bold; cursor: pointer; transition: 0.2s;
        }
        button.action:hover { opacity: 0.8; transform: scale(1.05); }
        
        .log-entry { font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    </style>
</head>
<body>
    <header>
        <div class="title">NHTML DEVTOOLS PRO <span style="font-weight:300; opacity:0.5; font-size:0.7rem;">v0.3.1</span></div>
        <div class="tabs">
            <div id="tab-sessions" class="tab active" onclick="switchTab('sessions')">SESSIONS</div>
            <div id="tab-network" class="tab" onclick="switchTab('network')">NETWORK LIVE</div>
        </div>
        <div style="font-size:0.7rem; color:var(--green); display:flex; align-items:center; gap:10px;">
            <button onclick="refreshSessions()" style="background:none; border:1px solid var(--text-dim); color:var(--text-dim); font-size:0.6rem; padding:2px 5px; border-radius:3px; cursor:pointer;">REFRESH</button>
            <span>● SYSTEM ONLINE</span>
        </div>
    </header>

    <main>
        <!-- PANE: SESSIONS -->
        <div id="pane-sessions" class="pane active" n-id="400">
            <h2 style="font-weight: 300; margin-bottom: 5px;">Historique des sessions</h2>
            <p style="color:var(--text-dim); font-size:0.8rem; margin-bottom:30px;">Consultez les sessions passées pour analyser les bugs ou comparer des états d'interface entre deux sessions (bouton CMP).</p>
            <div n-id="500" style="display: flex; flex-direction: column;">
                <div style="opacity:0.3; padding:20px;">Chargement de la base SQLite...</div>
            </div>
        </div>

        <!-- PANE: NETWORK -->
        <div id="pane-network" class="pane">
            <div style="padding:20px 20px 10px 20px;">
                <h3 style="margin:0; font-weight:300;">Network Monitor (Live)</h3>
                <p style="color:var(--text-dim); font-size:0.7rem; margin:5px 0 15px 0;">Surveillez en temps réel les paquets NBPS circulant entre le client et le gateway. Analyse de la latence PATCH et taille des données.</p>
            </div>
            <div class="net-header">
                <span>DIR</span>
                <span>TYPE</span>
                <span>SIZE</span>
                <span>METADATA / CONTEXT</span>
            </div>
            <div id="net-table" n-id="600" style="display: flex; flex-direction: column;">
            </div>
        </div>

        <!-- PANE: REPLAY / INSPECTOR -->
        <div id="pane-replay" class="pane" n-id="401">
            <div style="padding: 10px 20px; background: rgba(255,0,127,0.1); border-bottom: 1px solid var(--accent); display: flex; align-items: center; justify-content: space-between;">
                <div style="display:flex; align-items:center; gap: 20px;">
                    <button onclick="switchTab('sessions')" style="background: none; border: 1px solid var(--accent); color:var(--accent); cursor:pointer; padding:5px 10px; border-radius:4px; font-weight:bold;">← BACK TO SESSIONS</button>
                    <div style="display:flex; flex-direction:column;">
                        <h3 style="margin:0; font-size:1rem;">Replay Engine & Node Inspector</h3>
                        <div style="font-size:0.6rem; color:var(--accent); opacity:0.8;">Mode Diagnostic Actif - Analyse de l'historique de session</div>
                    </div>
                </div>
                <div n-id="301" style="font-family: 'JetBrains Mono'; color: var(--text-dim); font-size: 0.7rem;">SID: -</div>
            </div>
            
            <div style="display: flex; flex: 1; overflow: hidden; padding: 20px; gap: 20px;">
                <!-- Gauche: Rendu Visuel -->
                <div style="flex: 1.5; display: flex; flex-direction: column; gap: 15px;">
                    <div id="canvas-container" style="flex: 1; background: #000; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; display: flex; justify-content: center; align-items: center; position: relative;">
                        <div style="position:absolute; top:10px; left:10px; font-size:0.6rem; color:var(--text-dim); text-transform:uppercase;">Visual Sandbox</div>
                        <div id="replay_canvas" n-id="100" style="width: 320px; height: 480px; background: rgba(255,255,255,0.03); border: 1px dashed var(--accent); border-radius: 20px; padding: 20px;">
                            Prêt.
                        </div>
                    </div>
                    
                    <!-- Payload Tester (Postman for NHTML) -->
                    <div style="background: var(--surface); border-radius: 12px; padding: 15px; border: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;">
                        <h4 style="margin:0 0 5px 0; color:var(--accent); font-size:0.8rem;">PAYLOAD TESTER (Manual Injection)</h4>
                        <p style="font-size:0.6rem; color:var(--text-dim); margin:0 0 10px 0;">Injectez manuellement des paquets EVENT ou CUSTOM vers le backend pour tester la robustesse des handlers PHP.</p>
                        <div style="display:grid; grid-template-columns: 80px 1fr 100px; gap:10px;">
                            <input id="test-nid" type="number" placeholder="NodeID" style="background:#000; border:1px solid #333; color:white; padding:5px; border-radius:4px; font-family: inherit;">
                            <input id="test-payload" type="text" placeholder="Custom Data" style="background:#000; border:1px solid #333; color:white; padding:5px; border-radius:4px; font-family: inherit;">
                            <button onclick="injectPayload()" style="background:var(--accent); color:white; border:none; border-radius:4px; font-weight:bold; cursor:pointer;">INJECT</button>
                        </div>
                    </div>
                </div>

                <!-- Droite: Logs & Diff -->
                <div id="inspector" style="flex: 1; background: var(--surface); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.1);">
                    <h4 style="margin:0; color:var(--accent); font-size:0.8rem;">HANDLER TRACE & STATE DIFF</h4>
                    <p style="font-size:0.7rem; color:var(--text-dim); margin:5px 0 15px 0;">Timeline des mutations et temps de réponse PHP.</p>
                    <div id="event_list" n-id="101" style="overflow-y: auto; flex: 1; color: var(--text-dim);"></div>
                </div>
            </div>

            <div class="controls" style="padding: 20px; background: var(--surface); border-top: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 20px;">
                <button class="action" n-id="201" n-click="step_forward">STEP FORWARD</button>
                <button class="action" n-id="202" n-click="reset_replay" style="background: #333;">RESET</button>
                <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px;">
                    <div n-id="102" style="height: 100%; background: var(--accent); width: 0%; border-radius: 3px; transition: 0.3s;"></div>
                </div>
                <div n-id="302" style="font-family: 'JetBrains Mono'; font-size: 0.8rem;">0 / 0</div>
            </div>
        </div>
    </main>

    <script>
        let selectedForCompare = null;

        function injectPayload() {
            const nid = parseInt(document.getElementById('test-nid').value);
            const val = document.getElementById('test-payload').value;
            if (isNaN(nid)) return;
            
            // Format NBPS: [0x02][NodeID:4][Payload]
            const encoder = new TextEncoder();
            const payloadBytes = encoder.encode(val);
            const pkt = new Uint8Array(5 + payloadBytes.length);
            pkt[0] = 0x02;
            const view = new DataView(pkt.buffer);
            view.setUint32(1, nid, false);
            pkt.set(payloadBytes, 5);
            
            if(window.nhtml_socket) window.nhtml_socket.send(pkt.buffer);
            alert("Payload injecté vers NodeID: " + nid);
        }

        function switchTab(id, pushHistory = true) {
            selectedForCompare = null;
            
            // UI Update
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            const activeTab = document.getElementById('tab-' + id);
            if(activeTab) activeTab.classList.add('active');
            
            document.querySelectorAll('.pane').forEach(p => p.classList.remove('active'));
            document.getElementById('pane-' + id).classList.add('active');
            
            // History Management
            if (pushHistory) {
                history.pushState({tab: id}, "", id === 'sessions' ? "/" : "#" + id);
            }
        }

        window.onpopstate = function(event) {
            if (event.state && event.state.tab) {
                switchTab(event.state.tab, false);
            } else {
                switchTab('sessions', false);
            }
        };

        function refreshSessions() {
            if(window.nhtml_socket && window.nhtml_socket.readyState === 1) {
                window.nhtml_socket.send(new Uint8Array([0x04]).buffer);
            }
        }

        function startCompare(sid, btn) {
            if (!selectedForCompare) {
                selectedForCompare = sid;
                btn.innerText = "SÉLECT. CIBLE...";
                btn.style.background = "var(--green)";
                btn.style.color = "#000";
            } else {
                if (selectedForCompare === sid) {
                    selectedForCompare = null;
                    btn.innerText = "CMP";
                    btn.style.background = "rgba(255,255,255,0.05)";
                    btn.style.color = "inherit";
                    return;
                }
                const encoder = new TextEncoder();
                const sid1 = encoder.encode(selectedForCompare);
                const sid2 = encoder.encode(sid);
                const pkt = new Uint8Array(1 + 1 + sid1.length + 1 + sid2.length);
                pkt[0] = 0x04;
                pkt[1] = sid1.length;
                pkt.set(sid1, 2);
                pkt[2 + sid1.length] = sid2.length;
                pkt.set(sid2, 3 + sid1.length);
                
                window.nhtml_socket.send(pkt.buffer);
                selectedForCompare = null;
                btn.innerText = "CMP";
                btn.style.background = "rgba(255,255,255,0.05)";
                btn.style.color = "inherit";
                
                // Show replay pane as it will receive the comparison result
                switchTab('replay');
            }
        }

        // Initialisation de l'historique
        history.replaceState({tab: 'sessions'}, "", "/");
    </script>

    <script type="module">
        import { initNhtml } from 'http://127.0.0.1:8000/counter/polyfill/bridge.js';
        initNhtml('ws://' + window.location.hostname + ':8081/ws');
    </script>
</body>
</html>
